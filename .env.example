POSTGRES_DB=pomodoro_reflection
POSTGRES_USER=pomodoro_app
POSTGRES_PASSWORD=local_development_only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=local-development-key-change-before-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
DJANGO_NUM_PROXIES=0

# Cloud Runでは.envを使わず、次の値を環境変数またはSecretとして設定する。
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require&channel_binding=require

